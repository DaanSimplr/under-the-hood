      "poster": "media/hero/home-hero-poster.webp",
      "aspect": "16:9",
      "resolution": "1920x1080",
      "durationSec": 6,
      "loop": true,
      "maxSizeKB": 3500,
      "alt": "",
      "brief": "Generic car silhouette in a dark studio, slow orbit, rim light, faint exploded-parts ghosting. No logos.",
      "status": "generated"
    },
    {
      "id": "explorer-bg-loop",
      "type": "video",
